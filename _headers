# Cloudflare adds its Web Analytics script to any page it is allowed to change, and
# no-transform on Cache-Control tells it not to. That keeps "no analytics" true of this
# site's own code, whatever the dashboard says. Everything else in the value is the default
# for pages, to always check for a newer one.
/*
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cache-Control: public, max-age=0, must-revalidate, no-transform
